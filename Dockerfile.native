# syntax=docker/dockerfile:1

# Native-image counterpart to ./Dockerfile: builds the SPA, compiles the Micronaut
# server to a GraalVM native binary and ships it on a minimal Debian runtime.
# Build with: docker build -f Dockerfile.native -t porthole:native .   (or 'make build-native-in-docker')

# --- Stage 1: build the SPA ---
FROM node:26.13.1 AS frontend
WORKDIR /app/client

COPY client/package*.json ./
RUN npm ci

COPY client/ ./
RUN npm run build

# --- Stage 2: build the GraalVM native image ---
# This image ships both GraalVM (native-image) and the C toolchain native-image needs,
# so no GraalVM/gcc install is required on the host.
FROM ghcr.io/graalvm/native-image-community:25 AS native-build
WORKDIR /app

COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties ./
COPY gradle gradle
COPY server/build.gradle.kts server/

# Warm the dependency cache (cache mount keeps it out of the layer, persists across builds)
RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew :server:dependencies --no-daemon

COPY server/src server/src

# Embed the built frontend into the Micronaut static-resources folder (classpath:static)
COPY --from=frontend /app/client/dist server/src/main/resources/static

RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew :server:nativeCompile -x test --no-daemon

# --- Stage 3: minimal runtime ---
# The binary is static except for libc (-H:+StaticExecutableWithDynamicLibC), so a
# distroless base (no shell, no package manager) suffices. :nonroot runs as uid 65532;
# /data is pre-created owned by that uid so a mounted volume is writable.
FROM gcr.io/distroless/base-debian12:nonroot AS runtime
WORKDIR /app

COPY --from=native-build --chown=65532:65532 /app/server/build/native/nativeCompile/porthole-server /app/porthole-server

# Seed /data (placeholder) so the named volume inherits nonroot ownership.
COPY --from=native-build --chown=65532:65532 /app/server/build.gradle.kts /data/.keep

ENV PORTHOLE_STORAGE_PATH=/data
VOLUME /data

EXPOSE 8080

USER 65532:65532

ENTRYPOINT ["/app/porthole-server"]
