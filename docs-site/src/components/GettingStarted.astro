---
---
<section id="install" style="background:var(--surface);">
  <div class="container">
    <h2 class="section-title">Get started in minutes</h2>
    <p class="section-sub">Prerequisites: Java 21, Node 22, Docker. At least one auth provider (GitHub OAuth, Keycloak OIDC, or Passkey) must be configured.</p>
    <style>
      .tabs { display:flex; gap:0.5rem; margin-bottom:1.5rem; flex-wrap:wrap; }
      .tab-btn {
        padding: 0.4rem 1rem;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        background: transparent;
        color: var(--muted);
        cursor: pointer;
        font-size: 0.72rem;
        font-family: 'Orbitron', monospace;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
      }
      .tab-btn.active, .tab-btn:hover {
        background: rgba(0,240,255,0.1);
        color: var(--accent);
        border-color: var(--accent);
        font-weight: 700;
      }
      .tab-pane { display: none; }
      .tab-pane.active { display: block; }
      .provider-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
        max-width: 900px;
        margin: 0 auto 2.5rem;
      }
      .provider-card {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.1rem 1.25rem;
        background: var(--bg);
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .provider-card-title {
        color: var(--accent);
        font-family: 'Orbitron', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 700;
      }
      .provider-card p {
        color: var(--muted);
        font-size: 0.77rem;
        font-family: 'Share Tech Mono', monospace;
        line-height: 1.65;
        margin: 0;
      }
      .provider-card code {
        color: var(--text);
        background: rgba(0,240,255,0.06);
        padding: 0.1rem 0.35rem;
        border-radius: 3px;
        font-size: 0.73rem;
      }
    </style>
    <div class="provider-grid">
      <div class="provider-card" style="border-left:3px solid hsl(185,100%,54%);">
        <div class="provider-card-title">&#x1F419; GitHub OAuth</div>
        <p>Best for teams already using GitHub. Register a free OAuth App at <code>github.com/settings/developers</code> and set <code>PORTHOLE_GITHUB_CLIENT_ID</code> + <code>SECRET</code>.</p>
      </div>
      <div class="provider-card" style="border-left:3px solid hsl(25,100%,54%);">
        <div class="provider-card-title">&#x1F510; Keycloak OIDC</div>
        <p>For enterprises with an existing SSO infrastructure. Uses PKCE — no client secret required for public clients. Set <code>PORTHOLE_KEYCLOAK_CLIENT_ID</code> + <code>PORTHOLE_KEYCLOAK_ISSUER_URI</code>. All OIDC endpoints are discovered automatically.</p>
      </div>
      <div class="provider-card" style="border-left:3px solid hsl(270,80%,60%);">
        <div class="provider-card-title">&#x1F511; Passkey (WebAuthn)</div>
        <p>Password-free login with a hardware key or platform authenticator. Works out of the box on any deployment — no external provider needed.</p>
      </div>
    </div>
    <div style="max-width:720px; margin: 0 auto 2rem; background:var(--bg); border:1px solid var(--border); border-left: 3px solid var(--accent); border-radius:var(--radius); padding:1rem 1.25rem; display:flex; gap:1rem; align-items:flex-start;">
      <span style="font-size:1.3rem; line-height:1; flex-shrink:0;">&#x1F4BE;</span>
      <div style="font-family:'Share Tech Mono',monospace; font-size:0.78rem; color:var(--muted); line-height:1.75;">
        <strong style="color:var(--accent); font-family:'Orbitron',monospace; font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase;">No database required.</strong><br/>
        All map and user data is persisted as plain <strong style="color:var(--text);">JSON files</strong> in the <code>data/</code> directory — no PostgreSQL, no Redis, nothing to install or configure.
        <br/>
        <span style="color:var(--accent); opacity:0.7;">&#x26A0;</span>&nbsp;<strong style="color:var(--text);">Backups advised:</strong> simply copy or snapshot the <code>data/</code> folder regularly. When running via Docker, mount it as a volume so data survives container restarts.
      </div>
    </div>
    <div style="max-width:720px; margin: 0 auto 2rem; background:var(--bg); border:1px solid var(--border); border-left: 3px solid hsl(270,80%,60%); border-radius:var(--radius); padding:1rem 1.25rem; display:flex; gap:1rem; align-items:flex-start;">
      <span style="font-size:1.3rem; line-height:1; flex-shrink:0;">&#x1F3F7;&#xFE0F;</span>
      <div style="font-family:'Share Tech Mono',monospace; font-size:0.78rem; color:var(--muted); line-height:1.75;">
        <strong style="color:hsl(270,80%,70%); font-family:'Orbitron',monospace; font-size:0.7rem; letter-spacing:0.1em; text-transform:uppercase;">Custom tagline.</strong><br/>
        The claim shown beneath the logo on the login screen defaults to <code>for teams</code>. Override it with:<br/>
        <code>PORTHOLE_TAGLINE=🚀 your custom text</code><br/>
        Any UTF-8 string (including emoji) is accepted.
      </div>
    </div>
    <div style="max-width:720px; margin:0 auto;">
      <div class="tabs">
        <button class="tab-btn active" onclick="showTab('dev')">Dev Mode</button>
        <button class="tab-btn" onclick="showTab('docker')">Docker</button>
        <button class="tab-btn" onclick="showTab('build')">Full Build</button>
        <button class="tab-btn" onclick="showTab('keycloak')">Keycloak</button>
      </div>
      <div id="tab-dev" class="tab-pane active">
        <pre><code><span style="color:#8b949e"># 1. Clone &amp; configure</span>
git clone https://github.com/dedica-team/porthole.git
cd porthole
cp .env.example .env    <span style="color:#8b949e"># add PORTHOLE_GITHUB_CLIENT_ID / SECRET</span>
<span style="color:#8b949e"># 2. Install dependencies</span>
make setup
<span style="color:#8b949e"># 3. Start (Micronaut :8080 + Vite :5173)</span>
make dev</code></pre>
        <p style="color:var(--muted); font-size:0.875rem; margin-top:0.75rem;">
          Open <a href="http://localhost:5173">localhost:5173</a> for the React dev server
          or <a href="http://localhost:8080">localhost:8080</a> for the API.
        </p>
      </div>
      <div id="tab-docker" class="tab-pane">
        <pre><code><span style="color:#8b949e"># 1. Create a folder for persistent JSON data</span>
mkdir -p ./data
<span style="color:#8b949e"># 2. Pull the published image</span>
docker pull dedica/porthole:latest
<span style="color:#8b949e"># 3. Run Porthole (expects auth-related env vars in .env)</span>
docker run -d --name porthole -p 8080:8080 -p 8081:8081 \
  --env-file .env \
  -e PORTHOLE_ALLOWED_ORIGINS=http://localhost:8080 \
  -v "$(pwd)/data:/data" \
  dedica/porthole:latest</code></pre>
        <p style="color:var(--muted); font-size:0.875rem; margin-top:0.75rem;">
          Full app (API + UI) available at <a href="http://localhost:8080">localhost:8080</a>. No local Docker build is required; just make sure your <code>.env</code> contains the auth-provider settings you want to use, plus redirect/origin values that match <code>http://localhost:8080</code>.
        </p>
      </div>
      <div id="tab-build" class="tab-pane">
        <pre><code><span style="color:#8b949e"># Build server JAR + client dist</span>
make build
<span style="color:#8b949e"># Run the JAR directly</span>
java -jar server/target/porthole-*.jar</code></pre>
        <p style="color:var(--muted); font-size:0.875rem; margin-top:0.75rem;">
          The client's <code>dist/</code> is automatically served by Micronaut from the JAR.
        </p>
      </div>
      <div id="tab-keycloak" class="tab-pane">
        <p style="color:var(--muted); font-size:0.82rem; margin-bottom:1rem; font-family:'Share Tech Mono',monospace; line-height:1.7;">
          Add these variables to your <code>.env</code> (or deployment environment) alongside any other provider config.
          The "Access via Keycloak" button appears automatically once both <code>PORTHOLE_KEYCLOAK_CLIENT_ID</code> and <code>PORTHOLE_KEYCLOAK_ISSUER_URI</code> are set.
          Porthole fetches all OIDC endpoint URLs from the issuer's discovery document (<code>ISSUER_URI/.well-known/openid-configuration</code>) at startup — no endpoint URLs need to be configured manually.
        </p>
        <pre><code><span style="color:#8b949e"># Keycloak realm URL (no trailing slash)</span>
PORTHOLE_KEYCLOAK_ISSUER_URI=https://keycloak.myhost.com/realms/myrealm
<span style="color:#8b949e"># Client ID created in your Keycloak realm</span>
PORTHOLE_KEYCLOAK_CLIENT_ID=porthole-client
<span style="color:#8b949e"># Client secret — leave blank for public (PKCE-only) clients</span>
PORTHOLE_KEYCLOAK_CLIENT_SECRET=
<span style="color:#8b949e"># Must match the "Valid redirect URIs" in Keycloak</span>
PORTHOLE_KEYCLOAK_REDIRECT_URI=https://porthole.myhost.com/auth/keycloak/callback</code></pre>
        <div style="margin-top:1.5rem; display:flex; flex-direction:column; gap:0.75rem;">
          {[
            { n:'1', title:'Create a client', body:'In your Keycloak realm, go to Clients and create a new OpenID Connect client.' },
            { n:'2', title:'Configure redirect URI', body:'Set Valid Redirect URIs to your deployment URL + /auth/keycloak/callback.' },
            { n:'3', title:'Choose client type', body:'Public client: disable Client Authentication (no secret needed). Confidential: enable it and set PORTHOLE_KEYCLOAK_CLIENT_SECRET.' },
            { n:'4', title:'Scopes', body:'Porthole requests openid, profile, and email. Make sure these scopes are assigned to the client.' },
          ].map(s => (
            <div style="display:flex; gap:1rem; align-items:flex-start;">
              <span style="min-width:1.6rem; height:1.6rem; border-radius:50%; background:rgba(0,240,255,0.12); border:1px solid var(--accent); color:var(--accent); font-size:0.7rem; font-family:'Orbitron',monospace; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-weight:700;">{s.n}</span>
              <div>
                <p style="color:var(--text); font-size:0.78rem; font-family:'Orbitron',monospace; letter-spacing:0.05em; margin:0 0 0.15rem;">{s.title}</p>
                <p style="color:var(--muted); font-size:0.77rem; font-family:'Share Tech Mono',monospace; line-height:1.6; margin:0;">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  function showTab(id: string) {
    document.querySelectorAll('.tab-pane').forEach(function(p) { p.classList.remove('active'); });
    document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
    var pane = document.getElementById('tab-' + id);
    if (pane) pane.classList.add('active');
    document.querySelectorAll('.tab-btn').forEach(function(b) {
      if (b.getAttribute('onclick') === "showTab('" + id + "')") b.classList.add('active');
    });
  }
  (window as unknown as Record<string, unknown>).showTab = showTab;
</script>
